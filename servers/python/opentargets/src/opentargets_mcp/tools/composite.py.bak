"""
Composite tools for OpenTargets Platform - Intent-driven, workflow-oriented tools.

This module provides high-level tools that combine multiple GraphQL queries
to support common research workflows, rather than exposing individual API endpoints.
"""
from typing import Any, Dict, List, Optional
from ..queries import OpenTargetsClient


class CompositeTools:
    """
    Intent-driven tools that intelligently combine multiple data sources.
    Designed for research workflows, not just API access.
    """

    # =========================================================================
    # Entity Discovery & Profiling
    # =========================================================================

    async def search_biomedical_entities(
        self,
        client: OpenTargetsClient,
        query: str,
        entity_types: Optional[List[str]] = None,
        limit: int = 25,
        suggest: bool = True
    ) -> Dict[str, Any]:
        """
        Unified search across targets, diseases, and drugs with optional suggestions.

        Args:
            query: Search term (gene symbol, disease name, drug name)
            entity_types: Filter by types: ["target", "disease", "drug"]. Default: all types
            limit: Max results per entity type (1-100)
            suggest: Include autocomplete suggestions

        Returns:
            {
                "results": {
                    "targets": [...],
                    "diseases": [...],
                    "drugs": [...]
                },
                "suggestions": [...] if suggest=True
            }
        """
        if entity_types is None:
            entity_types = ["target", "disease", "drug"]

        limit = max(1, min(limit, 100))

        # Build unified search query
        graphql_query = """
        query UnifiedSearch($queryString: String!, $pageSize: Int!) {
            search(queryString: $queryString, page: {index: 0, size: $pageSize}) {
                total
                hits {
                    id
                    entity
                    name
                    description
                    score
                }
            }
        }
        """

        result = await client._query(graphql_query, {
            "queryString": query,
            "pageSize": limit * len(entity_types)
        })

        # Organize by entity type
        organized = {
            "results": {
                "targets": [],
                "diseases": [],
                "drugs": []
            },
            "query": query,
            "total_hits": result.get("data", {}).get("search", {}).get("total", 0)
        }

        for hit in result.get("data", {}).get("search", {}).get("hits", []):
            entity_type = hit.get("entity", "").lower()
            if entity_type in entity_types and entity_type in organized["results"]:
                organized["results"][entity_type].append(hit)

        # Add suggestions if requested
        if suggest and query:
            suggestions_query = """
            query SearchSuggestions($queryString: String!) {
                search(queryString: $queryString, page: {index: 0, size: 5}) {
                    hits {
                        name
                        entity
                        score
                    }
                }
            }
            """
            suggestions_result = await client._query(suggestions_query, {"queryString": query})
            organized["suggestions"] = suggestions_result.get("data", {}).get("search", {}).get("hits", [])

        return organized

    async def get_target_profile(
        self,
        client: OpenTargetsClient,
        ensembl_id: str,
        sections: Optional[List[str]] = None,
        include_diseases: bool = True,
        include_drugs: bool = True,
        top_n_associations: int = 10
    ) -> Dict[str, Any]:
        """
        Get comprehensive target profile with flexible depth control.

        Args:
            ensembl_id: Ensembl gene ID (e.g., ENSG00000012048)
            sections: Data sections to include:
                - "identity": Basic info, synonyms, genomic location
                - "biology": Pathways, GO terms, expression
                - "safety": Safety information, adverse events
                - "tractability": Druggability assessment
                - "interactions": Protein-protein interactions
                Default: ["identity", "biology"]
            include_diseases: Include associated diseases (top N)
            include_drugs: Include known drugs
            top_n_associations: Number of top disease associations to include (1-100)

        Returns:
            Composite profile with requested sections
        """
        if sections is None:
            sections = ["identity", "biology"]

        profile = {
            "ensembl_id": ensembl_id,
            "sections_included": sections
        }

        # Build dynamic GraphQL query based on requested sections
        query_fragments = []

        # Always include basic identity
        query_fragments.append("""
            id
            approvedSymbol
            approvedName
            biotype
            functionDescriptions
        """)

        if "identity" in sections:
            query_fragments.append("""
                synonyms { label, source }
                genomicLocation { chromosome, start, end, strand }
                proteinIds { id, source }
                alternativeGenes
                transcriptIds
            """)

        if "biology" in sections:
            query_fragments.append("""
                geneOntology {
                    aspect
                    term { id, name }
                }
                pathways { pathway, pathwayId }
                expressions { tissue { label }, rna { level }, protein { level } }
            """)

        if "safety" in sections:
            query_fragments.append("""
                safetyLiabilities {
                    event
                    effects { direction, dosing }
                    datasource
                }
            """)

        if "tractability" in sections:
            query_fragments.append("""
                tractability {
                    label
                    modality
                    value
                }
            """)

        if "interactions" in sections:
            query_fragments.append("""
                interactions {
                    intA
                    targetB { approvedSymbol }
                    count
                    sourceDatabase
                }
            """)

        # Main target query
        graphql_query = f"""
        query TargetProfile($ensemblId: String!) {{
            target(ensemblId: $ensemblId) {{
                {' '.join(query_fragments)}
            }}
        }}
        """

        result = await client._query(graphql_query, {"ensemblId": ensembl_id})
        profile["target"] = result.get("data", {}).get("target", {})

        # Add associated diseases if requested
        if include_diseases:
            diseases_query = """
            query TargetDiseases($ensemblId: String!, $size: Int!) {
                target(ensemblId: $ensemblId) {
                    associatedDiseases(page: {index: 0, size: $size}) {
                        count
                        rows {
                            disease { id, name }
                            score
                            datatypeScores { id, score }
                        }
                    }
                }
            }
            """
            diseases_result = await client._query(diseases_query, {
                "ensemblId": ensembl_id,
                "size": min(top_n_associations, 100)
            })
            profile["associated_diseases"] = diseases_result.get("data", {}).get("target", {}).get("associatedDiseases", {})

        # Add known drugs if requested
        if include_drugs:
            drugs_query = """
            query TargetDrugs($ensemblId: String!) {
                target(ensemblId: $ensemblId) {
                    knownDrugs {
                        uniqueDrugs
                        uniqueDiseases
                        count
                        rows {
                            drug { name, id }
                            phase
                            status
                            mechanismOfAction
                        }
                    }
                }
            }
            """
            drugs_result = await client._query(drugs_query, {"ensemblId": ensembl_id})
            profile["known_drugs"] = drugs_result.get("data", {}).get("target", {}).get("knownDrugs", {})

        return profile

    async def get_disease_profile(
        self,
        client: OpenTargetsClient,
        efo_id: str,
        sections: Optional[List[str]] = None,
        top_n_targets: int = 10
    ) -> Dict[str, Any]:
        """
        Get comprehensive disease profile with flexible depth control.

        Args:
            efo_id: EFO disease ID (e.g., EFO_0000305)
            sections: Data sections to include:
                - "identity": Basic info, synonyms, therapeutic areas
                - "targets": Associated targets with scores
                - "phenotypes": HPO phenotype associations
                - "otar_projects": OTAR research projects
                Default: ["identity", "targets"]
            top_n_targets: Number of top target associations (1-100)

        Returns:
            Composite disease profile with requested sections
        """
        if sections is None:
            sections = ["identity", "targets"]

        profile = {
            "efo_id": efo_id,
            "sections_included": sections
        }

        # Build dynamic query
        query_fragments = []

        # Always include basic identity
        query_fragments.append("""
            id
            name
            description
        """)

        if "identity" in sections:
            query_fragments.append("""
                synonyms {
                    relation
                    terms
                }
                therapeuticAreas {
                    id
                    name
                }
                dbXRefs
            """)

        if "phenotypes" in sections:
            query_fragments.append("""
                phenotypes {
                    rows {
                        phenotypeHPO { id, name }
                        evidence { resource }
                    }
                }
            """)

        if "otar_projects" in sections:
            query_fragments.append("""
                otarProjects {
                    projectId
                    status
                    integratesChemicalProbes
                    integratesCRISPRScreens
                }
            """)

        # Main disease query
        graphql_query = f"""
        query DiseaseProfile($efoId: String!) {{
            disease(efoId: $efoId) {{
                {' '.join(query_fragments)}
            }}
        }}
        """

        result = await client._query(graphql_query, {"efoId": efo_id})
        profile["disease"] = result.get("data", {}).get("disease", {})

        # Add associated targets if requested
        if "targets" in sections:
            targets_query = """
            query DiseaseTargets($efoId: String!, $size: Int!) {
                disease(efoId: $efoId) {
                    associatedTargets(page: {index: 0, size: $size}) {
                        count
                        rows {
                            target { id, approvedSymbol, approvedName }
                            score
                            datatypeScores { id, score }
                        }
                    }
                }
            }
            """
            targets_result = await client._query(targets_query, {
                "efoId": efo_id,
                "size": min(top_n_targets, 100)
            })
            profile["associated_targets"] = targets_result.get("data", {}).get("disease", {}).get("associatedTargets", {})

        return profile

    # =========================================================================
    # Association & Evidence Analysis
    # =========================================================================

    async def analyze_target_disease_association(
        self,
        client: OpenTargetsClient,
        ensembl_id: str,
        efo_id: str,
        evidence_types: Optional[List[str]] = None,
        include_biomarkers: bool = True,
        min_score: float = 0.0
    ) -> Dict[str, Any]:
        """
        Deep analysis of target-disease association with comprehensive evidence.

        Args:
            ensembl_id: Target Ensembl ID
            efo_id: Disease EFO ID
            evidence_types: Filter evidence types (default: all)
            include_biomarkers: Include biomarker information
            min_score: Minimum evidence score threshold (0.0-1.0)

        Returns:
            Comprehensive association analysis with scored evidence
        """
        analysis = {
            "target_id": ensembl_id,
            "disease_id": efo_id,
            "min_score": min_score
        }

        # Get overall association score
        assoc_query = """
        query AssociationScore($efoId: String!) {
            disease(efoId: $efoId) {
                associatedTargets(page: {index: 0, size: 1000}) {
                    rows {
                        target { id }
                        score
                        datatypeScores { id, score }
                    }
                }
            }
        }
        """

        assoc_result = await client._query(assoc_query, {
            "efoId": efo_id
        })

        # Find the specific target association
        association = None
        rows = assoc_result.get("data", {}).get("disease", {}).get("associatedTargets", {}).get("rows", [])
        for row in rows:
            if row.get("target", {}).get("id") == ensembl_id:
                association = row
                break

        if association:
            analysis["overall_score"] = association.get("score", 0.0)
            analysis["datatype_scores"] = association.get("datatypeScores", [])
        else:
            analysis["overall_score"] = 0.0
            analysis["datatype_scores"] = []

        # Get detailed evidence
        evidence_query = """
        query TargetDiseaseEvidence($ensemblId: String!, $efoId: String!, $size: Int!) {
            target(ensemblId: $ensemblId) {
                evidences(efoIds: [$efoId], size: $size) {
                    count
                    rows {
                        disease { id, name }
                        score
                        datasourceId
                        datatypeId
                        literature
                    }
                }
            }
        }
        """

        evidence_result = await client._query(evidence_query, {
            "ensemblId": ensembl_id,
            "efoId": efo_id,
            "size": 100
        })

        evidences = evidence_result.get("data", {}).get("target", {}).get("evidences", {}).get("rows", [])

        # Filter by score and evidence type
        filtered_evidences = []
        for ev in evidences:
            if ev.get("score", 0.0) >= min_score:
                if evidence_types is None or ev.get("datatypeId") in evidence_types:
                    filtered_evidences.append(ev)

        analysis["evidence_count"] = len(filtered_evidences)
        analysis["evidence"] = filtered_evidences

        # Get biomarkers if requested
        if include_biomarkers:
            biomarker_query = """
            query DiseaseAssociatedBiomarkers($efoId: String!) {
                disease(efoId: $efoId) {
                    id
                    name
                }
            }
            """
            biomarker_result = await client._query(biomarker_query, {"efoId": efo_id})
            analysis["biomarkers"] = biomarker_result.get("data", {}).get("disease", {})

        return analysis

    async def discover_therapeutic_opportunities(
        self,
        client: OpenTargetsClient,
        disease_id: str,
        filters: Optional[Dict[str, Any]] = None,
        ranking_strategy: str = "genetic_evidence",
        limit: int = 20
    ) -> Dict[str, Any]:
        """
        Intelligent target prioritization with smart ranking strategies.

        Args:
            disease_id: EFO disease ID
            filters: Filter criteria (e.g., min_score, tractability)
            ranking_strategy: "genetic_evidence", "approved_drugs", "safety", "novelty"
            limit: Max targets to return

        Returns:
            Ranked list of therapeutic opportunities
        """
        discovery = {
            "disease_id": disease_id,
            "ranking_strategy": ranking_strategy,
            "limit": limit
        }

        # Get all associated targets with comprehensive data
        targets_query = """
        query TherapeuticTargets($efoId: String!, $size: Int!) {
            disease(efoId: $efoId) {
                name
                associatedTargets(page: {index: 0, size: $size}) {
                    count
                    rows {
                        target {
                            id
                            approvedSymbol
                            approvedName
                            tractability {
                                label
                                modality
                                value
                            }
                        }
                        score
                        datatypeScores { id, score }
                    }
                }
            }
        }
        """

        result = await client._query(targets_query, {
            "efoId": disease_id,
            "size": min(limit * 2, 100)  # Get more to allow filtering
        })

        disease_data = result.get("data", {}).get("disease", {})
        discovery["disease_name"] = disease_data.get("name", "")

        targets = disease_data.get("associatedTargets", {}).get("rows", [])

        # Apply filters
        if filters:
            min_score = filters.get("min_score", 0.0)
            targets = [t for t in targets if t.get("score", 0.0) >= min_score]

        # Apply ranking strategy
        if ranking_strategy == "genetic_evidence":
            # Prioritize genetic evidence
            for target in targets:
                genetic_score = 0.0
                for dt in target.get("datatypeScores", []):
                    if dt.get("id") in ["genetic_association", "somatic_mutation"]:
                        genetic_score += dt.get("score", 0.0)
                target["rank_score"] = genetic_score
            targets.sort(key=lambda x: x.get("rank_score", 0.0), reverse=True)

        elif ranking_strategy == "approved_drugs":
            # Prioritize targets with known drugs
            for target in targets:
                # Higher score for targets with existing drugs
                target["rank_score"] = target.get("score", 0.0) * 1.5
            targets.sort(key=lambda x: x.get("rank_score", 0.0), reverse=True)

        elif ranking_strategy == "safety":
            # Prioritize by overall score (safety implicitly considered)
            targets.sort(key=lambda x: x.get("score", 0.0), reverse=True)

        elif ranking_strategy == "novelty":
            # Prioritize targets with fewer known drugs (novel targets)
            targets.sort(key=lambda x: x.get("score", 0.0), reverse=True)
            # Would ideally query knownDrugs count here

        else:
            # Default: sort by overall score
            targets.sort(key=lambda x: x.get("score", 0.0), reverse=True)

        # Limit results
        discovery["opportunities"] = targets[:limit]
        discovery["total_candidates"] = len(targets)

        return discovery

    # =========================================================================
    # Drug Mechanism Tools
    # =========================================================================

    async def explore_drug_mechanism(
        self,
        client: OpenTargetsClient,
        drug_id: str,
        include_targets: bool = True,
        include_indications: bool = True,
        include_adverse_events: bool = False
    ) -> Dict[str, Any]:
        """
        Explore drug mechanism of action, targets, and clinical applications.

        Args:
            drug_id: ChEMBL ID (e.g., CHEMBL1234)
            include_targets: Include target information
            include_indications: Include disease indications
            include_adverse_events: Include adverse event data

        Returns:
            Comprehensive drug mechanism profile
        """
        mechanism = {"drug_id": drug_id}

        # Get drug information with mechanism
        drug_query = """
        query DrugMechanism($chemblId: String!) {
            drug(chemblId: $chemblId) {
                id
                name
                description
                maximumClinicalTrialPhase
                hasBeenWithdrawn
                blackBoxWarning
            }
        }
        """

        result = await client._query(drug_query, {"chemblId": drug_id})
        mechanism["drug"] = result.get("data", {}).get("drug", {})

        # Get mechanism of action and targets
        if include_targets:
            moa_query = """
            query DrugTargets($chemblId: String!) {
                drug(chemblId: $chemblId) {
                    linkedTargets {
                        count
                        rows {
                            id
                            approvedSymbol
                            approvedName
                        }
                    }
                    mechanismsOfAction {
                        rows {
                            mechanismOfAction
                            targetName
                            targets {
                                id
                                approvedSymbol
                            }
                        }
                    }
                }
            }
            """
            moa_result = await client._query(moa_query, {"chemblId": drug_id})
            drug_data = moa_result.get("data", {}).get("drug", {})
            mechanism["targets"] = drug_data.get("linkedTargets", {})
            mechanism["mechanisms_of_action"] = drug_data.get("mechanismsOfAction", {})

        # Get disease indications
        if include_indications:
            indications_query = """
            query DrugIndications($chemblId: String!) {
                drug(chemblId: $chemblId) {
                    linkedDiseases {
                        count
                        rows {
                            id
                            name
                        }
                    }
                }
            }
            """
            ind_result = await client._query(indications_query, {"chemblId": drug_id})
            mechanism["indications"] = ind_result.get("data", {}).get("drug", {}).get("linkedDiseases", {})

        # Get adverse events
        if include_adverse_events:
            # Note: Would query adverse events if available in GraphQL schema
            mechanism["adverse_events"] = {"note": "Adverse event data would be queried here"}

        return mechanism

