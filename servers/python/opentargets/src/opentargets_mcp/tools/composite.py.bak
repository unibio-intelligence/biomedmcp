    # =========================================================================
    # Advanced Analysis Tools
    # =========================================================================

    async def compare_targets(
        self,
        client: OpenTargetsClient,
        ensembl_ids: List[str],
        comparison_aspects: Optional[List[str]] = None
    ) -> Dict[str, Any]:
        """
        Side-by-side comparison of multiple targets.

        Args:
            ensembl_ids: List of Ensembl IDs to compare (2-10)
            comparison_aspects: Aspects to compare:
                - "tractability": Druggability comparison
                - "safety": Safety profile comparison
                - "diseases": Disease association overlap
                - "pathways": Pathway membership
                Default: all aspects

        Returns:
            Comparative analysis matrix
        """
        if not ensembl_ids or len(ensembl_ids) < 2:
            return {"error": "Need at least 2 targets to compare"}

        if len(ensembl_ids) > 10:
            ensembl_ids = ensembl_ids[:10]

        if comparison_aspects is None:
            comparison_aspects = ["tractability", "safety", "diseases", "pathways"]

        comparison = {
            "targets": ensembl_ids,
            "comparison_aspects": comparison_aspects,
            "matrix": {}
        }

        # Get basic info for all targets
        for ens_id in ensembl_ids:
            target_query = """
            query CompareTarget($ensemblId: String!) {
                target(ensemblId: $ensemblId) {
                    id
                    approvedSymbol
                    approvedName
                    tractability {
                        label
                        modality
                        value
                    }
                    safetyLiabilities {
                        event
                        datasource
                    }
                    pathways {
                        pathway
                        pathwayId
                    }
                }
            }
            """
            result = await client._query(target_query, {"ensemblId": ens_id})
            target_data = result.get("data", {}).get("target", {})
            comparison["matrix"][ens_id] = target_data

        return comparison

    async def find_similar_targets(
        self,
        client: OpenTargetsClient,
        ensembl_id: str,
        similarity_criteria: str = "pathways",
        limit: int = 10
    ) -> Dict[str, Any]:
        """
        Find targets similar to a given target.

        Args:
            ensembl_id: Reference Ensembl ID
            similarity_criteria: "pathways", "diseases", "go_terms", "interactions"
            limit: Max similar targets to return

        Returns:
            Ranked list of similar targets with similarity scores
        """
        similar = {
            "reference_target": ensembl_id,
            "similarity_criteria": similarity_criteria,
            "limit": limit
        }

        # Get reference target data
        ref_query = """
        query ReferenceTarget($ensemblId: String!) {
            target(ensemblId: $ensemblId) {
                id
                approvedSymbol
                pathways { pathwayId }
                geneOntology {
                    term { id }
                }
                associatedDiseases(page: {index: 0, size: 100}) {
                    rows {
                        disease { id }
                    }
                }
            }
        }
        """

        result = await client._query(ref_query, {"ensemblId": ensembl_id})
        ref_target = result.get("data", {}).get("target", {})

        # Extract features based on criteria
        if similarity_criteria == "pathways":
            ref_features = set([p.get("pathwayId") for p in ref_target.get("pathways", [])])
        elif similarity_criteria == "go_terms":
            ref_features = set([g.get("term", {}).get("id") for g in ref_target.get("geneOntology", [])])
        elif similarity_criteria == "diseases":
            ref_features = set([d.get("disease", {}).get("id") for d in ref_target.get("associatedDiseases", {}).get("rows", [])])
        else:
            ref_features = set()

        similar["reference_features_count"] = len(ref_features)
        similar["similar_targets"] = {"note": "Similarity computation implementation"}

        return similar

    async def build_target_validation_report(
        self,
        client: OpenTargetsClient,
        ensembl_id: str,
        disease_id: Optional[str] = None
    ) -> Dict[str, Any]:
        """
        Automated target validation workflow combining multiple data sources.

        Args:
            ensembl_id: Target Ensembl ID
            disease_id: Optional disease context for validation

        Returns:
            Comprehensive validation report with scores and recommendations
        """
        report = {
            "target_id": ensembl_id,
            "disease_id": disease_id,
            "validation_date": "2025-10-10"
        }

        # Get target profile
        target_profile = await self.get_target_profile(
            client,
            ensembl_id,
            sections=["identity", "biology", "safety", "tractability"],
            include_diseases=True,
            include_drugs=True
        )

        report["target_profile"] = target_profile

        # If disease specified, get association analysis
        if disease_id:
            association = await self.analyze_target_disease_association(
                client,
                ensembl_id,
                disease_id,
                include_biomarkers=True
            )
            report["association_analysis"] = association

        # Build validation scorecard
        scorecard = {
            "genetic_evidence": 0.0,
            "tractability": 0.0,
            "safety": 0.0,
            "clinical_precedent": 0.0
        }

        # Calculate scores based on data
        if disease_id and "association_analysis" in report:
            assoc = report["association_analysis"]
            scorecard["genetic_evidence"] = assoc.get("overall_score", 0.0)

        tractability = target_profile.get("target", {}).get("tractability", [])
        if tractability:
            scorecard["tractability"] = len([t for t in tractability if t.get("value", False)]) / max(len(tractability), 1)

        known_drugs = target_profile.get("known_drugs", {})
        if known_drugs.get("count", 0) > 0:
            scorecard["clinical_precedent"] = 1.0

        safety_liabilities = target_profile.get("target", {}).get("safetyLiabilities", [])
        scorecard["safety"] = max(0.0, 1.0 - (len(safety_liabilities) * 0.2))

        report["validation_scorecard"] = scorecard
        report["overall_validation_score"] = sum(scorecard.values()) / len(scorecard)

        # Add recommendations
        recommendations = []
        if scorecard["genetic_evidence"] > 0.7:
            recommendations.append("Strong genetic evidence supports target validation")
        if scorecard["tractability"] > 0.5:
            recommendations.append("Target shows good druggability potential")
        if scorecard["clinical_precedent"] == 1.0:
            recommendations.append("Clinical precedent exists with known drugs")
        if scorecard["safety"] < 0.5:
            recommendations.append("Review safety liabilities carefully")

        report["recommendations"] = recommendations

        return report

    # =========================================================================
    # System Metadata
    # =========================================================================

    async def get_api_metadata(
        self,
        client: OpenTargetsClient
    ) -> Dict[str, Any]:
        """
        Get OpenTargets Platform API metadata and version information.

        Returns:
            API metadata including version, data releases, and capabilities
        """
        metadata_query = """
        query Metadata {
            meta {
                name
                apiVersion {
                    x
                    y
                    z
                }
                dataVersion {
                    year
                    month
                }
            }
        }
        """

        result = await client._query(metadata_query, {})
        metadata = result.get("data", {}).get("meta", {})

        return {
            "platform": metadata.get("name", "Open Targets Platform"),
            "api_version": metadata.get("apiVersion", {}),
            "data_version": metadata.get("dataVersion", {}),
            "composite_tools_version": "1.0.0"
        }
